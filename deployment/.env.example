# Local reference defaults. Never commit .env or generated secrets.
COMPOSE_PROJECT_NAME=docs-blueprint
DOCMOST_IMAGE=docmost/docmost:0.96.0
POSTGRES_IMAGE=postgres:18
REDIS_IMAGE=redis:8
CADDY_IMAGE=caddy:2
APP_URL=http://localhost:3000
# Independent outputs of openssl rand -hex 32. Empty values fail closed.
APP_SECRET=
POSTGRES_PASSWORD=
# TLS mode only: set a domain you control and matching https APP_URL.
DOCS_DOMAIN=docs.example.com
# Optional mail: configure and test before real user onboarding.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM_ADDRESS=docs@example.com
